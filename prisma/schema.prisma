generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Dominio deportivo
// ---------------------------------------------------------------------------

model Category {
  id              String  @id @default(uuid())
  name            String
  shortName       String  @unique
  slug            String? @unique
  description     String?
  color           String? // Color de acento en hex (#RRGGBB)
  website         String?
  logoUrl         String?
  isInternational Boolean @default(false)
  sortOrder       Int     @default(100)

  pilots     Pilot[]
  news       News[]
  raceEvents RaceEvent[]
  results    Result[]
  standings  Standing[]

  @@map("categories")
}

model Pilot {
  id                 String    @id @default(uuid())
  fullName           String
  slug               String    @unique
  categoryId         String
  category           Category  @relation(fields: [categoryId], references: [id])
  nationality        String    @default("Argentina")
  team               String?
  carNumber          Int?
  birthPlace         String?
  bio                String?
  height             Float?
  dateOfBirth        DateTime?
  profileImageUrl    String?
  isActive           Boolean   @default(true)
  featured           Boolean   @default(false)
  // Nombres alternativos para detectar menciones en noticias, separados por coma
  aliases            String?
  // Identificador en fuentes externas (ej: driverId de Jolpica/Ergast para F1)
  externalId         String?   @unique
  socialMediaHandles String? // JSON: { "instagram": "...", "x": "..." }

  news      News[]
  results   Result[]
  standings Standing[]
  followers Follow[]

  @@index([categoryId])
  @@map("pilots")
}

model News {
  id          String   @id @default(uuid())
  title       String
  summary     String?
  originalUrl String   @unique
  sourceName  String
  publishedAt DateTime @default(now())
  imageUrl    String?
  createdAt   DateTime @default(now())

  pilotId String?
  pilot   Pilot?  @relation(fields: [pilotId], references: [id], onDelete: SetNull)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([publishedAt])
  @@index([pilotId])
  @@index([categoryId])
  @@map("news")
}

model RaceEvent {
  id          String   @id @default(uuid())
  name        String
  description String?
  location    String?
  circuit     String?
  country     String?
  date        DateTime
  season      Int?
  round       Int?
  // SCHEDULED | FINISHED | CANCELLED
  status      String   @default("SCHEDULED")
  // Horarios de las sesiones: [{ "name": "Clasificación", "date": "ISO" }]
  sessions    Json?
  // Identificador estable para sincronizaciones (ej: "f1-2026-19")
  externalId  String?  @unique

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  results Result[]

  @@index([date])
  @@index([categoryId, season])
  @@map("race_events")
}

model Result {
  id       String  @id @default(uuid())
  position Int
  timeGap  String?
  points   Float?
  grid     Int?
  team     String?
  status   String?

  // Piloto seguido (opcional, para tablas completas)
  pilotId String?
  pilot   Pilot?  @relation(fields: [pilotId], references: [id], onDelete: SetNull)

  // Datos del piloto externo
  pilotName String?
  pilotFlag String?

  raceEventId String?
  raceEvent   RaceEvent? @relation(fields: [raceEventId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  @@index([raceEventId])
  @@index([pilotId])
  @@map("results")
}

model Standing {
  id        String   @id @default(uuid())
  season    Int
  // DRIVER | TEAM
  kind      String   @default("DRIVER")
  position  Int
  name      String
  flag      String?
  team      String?
  points    Float    @default(0)
  wins      Int      @default(0)
  updatedAt DateTime @updatedAt

  pilotId String?
  pilot   Pilot?  @relation(fields: [pilotId], references: [id], onDelete: SetNull)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, season, kind])
  @@map("standings")
}

// Registro de ejecuciones de sincronización automática
model SyncLog {
  id        String   @id @default(uuid())
  source    String
  ok        Boolean
  message   String?
  createdAt DateTime @default(now())

  @@index([source, createdAt])
  @@map("sync_logs")
}

// ---------------------------------------------------------------------------
// Usuarios y autenticación
// ---------------------------------------------------------------------------

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String?            @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  accounts          Account[]
  sessions          Session[]
  follows           Follow[]
  pushSubscriptions PushSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Follow {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  pilotId String
  pilot   Pilot  @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, pilotId])
  @@map("follows")
}

model PushSubscription {
  id       String  @id @default(cuid())
  endpoint String  @unique
  p256dh   String
  auth     String
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}
