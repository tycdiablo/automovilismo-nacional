# Base de datos PostgreSQL (Neon, Supabase, Railway, local...)
DATABASE_URL="postgresql://usuario:password@host:5432/motor"

# URL pública del sitio (SEO, sitemap, iCal)
NEXT_PUBLIC_SITE_URL="https://tu-dominio.com"

# NextAuth: generá un valor con `openssl rand -base64 32`
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Emails con acceso al panel /admin (separados por coma)
ADMIN_EMAILS="vos@email.com"

# Secreto para /api/cron/sync (Vercel Cron lo envía solo; GitHub Actions lo usa como secret)
CRON_SECRET=""
# Secreto para los webhooks /api/news/webhook, /api/results/webhook y /api/db/seed
WEBHOOK_SECRET=""

# Notificaciones push (opcional). Generá las claves con `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:vos@email.com"
